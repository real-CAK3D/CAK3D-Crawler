{
  "name": "arachnotes",
  "version": "1.9.0",
  "private": true,
  "description": "A spider that crawls any text, sorts its keywords into topics, and builds cited research notes.",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "build": "node scripts/make-icons.mjs && node scripts/build-web.mjs",
